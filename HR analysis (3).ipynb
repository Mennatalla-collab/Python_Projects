<span class="n">wlb_attrition</span> <span class="o">=</span> <span class="n">wlb_attrition</span><span class="o">.</span><span class="n">reset_index</span><span class="p">()</span><span class="o">.</span><span class="n">rename</span><span class="p">(</span><span class="n">columns</span><span class="o">=</span><span class="p">{</span><span class="s1">'Yes'</span><span class="p">:</span> <span class="s1">'AttritionRate'</span><span class="p">})</span>
