<div class="highlight hl-ipython3"><pre><span></span><span class="c1"># 1. Calculate the exact attrition rate per business travel category</span>
<span class="n">travel_attrition</span> <span class="o">=</span> <span class="n">pd</span><span class="o">.</span><span class="n">crosstab</span><span class="p">(</span><span class="n">df</span><span class="p">[</span><span class="s1">'BusinessTravel'</span><span class="p">],</span> <span class="n">df</span><span class="p">[</span><span class="s1">'Attrition'</span><span class="p">],</span> <span class="n">normalize</span><span class="o">=</span><span class="s1">'index'</span><span class="p">)[</span><span class="s1">'Yes'</span><span class="p">]</span> <span class="o">*</span> <span class="mi">100</span>
<span class="n">travel_attrition</span> <span class="o">=</span> <span class="n">travel_attrition</span><span class="o">.</span><span class="n">reset_index</span><span class="p">()</span><span class="o">.</span><span class="n">rename</span><span class="p">(</span><span class="n">columns</span><span class="o">=</span><span class="p">{</span><span class="s1">'Yes'</span><span class="p">:</span> <span class="s1">'AttritionRate'</span><span class="p">})</span>
<span class="n">travel_attrition</span> <span class="o">=</span> <span class="n">travel_attrition</span><span class="o">.</span><span class="n">sort_values</span><span class="p">(</span><span class="n">by</span><span class="o">=</span><span class="s1">'AttritionRate'</span><span class="p">,</span> <span class="n">ascending</span><span class="o">=</span><span class="kc">False</span><span class="p">)</span>
<span class="nb">print</span><span class="p">(</span><span class="n">travel_attrition</span><span class="p">)</span>

<span class="c1"># 2. Plot the results using a clean and distinct bar chart</span>
<span class="n">plt</span><span class="o">.</span><span class="n">figure</span><span class="p">(</span><span class="n">figsize</span><span class="o">=</span><span class="p">(</span><span class="mi">9</span><span class="p">,</span> <span class="mi">5</span><span class="p">))</span>
<span class="n">sns</span><span class="o">.</span><span class="n">barplot</span><span class="p">(</span>
    <span class="n">data</span><span class="o">=</span><span class="n">travel_attrition</span><span class="p">,</span>
    <span class="n">x</span><span class="o">=</span><span class="s1">'AttritionRate'</span><span class="p">,</span>
    <span class="n">y</span><span class="o">=</span><span class="s1">'BusinessTravel'</span><span class="p">,</span>
    <span class="n">hue</span><span class="o">=</span><span class="s1">'BusinessTravel'</span><span class="p">,</span>
    <span class="n">palette</span><span class="o">=</span><span class="s1">'flare_r'</span><span class="p">,</span>
    <span class="n">legend</span><span class="o">=</span><span class="kc">False</span>
<span class="p">)</span>

<span class="n">plt</span><span class="o">.</span><span class="n">title</span><span class="p">(</span><span class="s1">'Attrition Rate by Business Travel Frequency (%)'</span><span class="p">,</span> <span class="n">fontsize</span><span class="o">=</span><span class="mi">14</span><span class="p">,</span> <span class="n">fontweight</span><span class="o">=</span><span class="s1">'bold'</span><span class="p">,</span> <span class="n">pad</span><span class="o">=</span><span class="mi">15</span><span class="p">)</span>
<span class="n">plt</span><span class="o">.</span><span class="n">xlabel</span><span class="p">(</span><span class="s1">'Attrition Rate (%)'</span><span class="p">,</span> <span class="n">fontsize</span><span class="o">=</span><span class="mi">12</span><span class="p">)</span>
<span class="n">plt</span><span class="o">.</span><span class="n">ylabel</span><span class="p">(</span><span class="s1">'Travel Frequency'</span><span class="p">,</span> <span class="n">fontsize</span><span class="o">=</span><span class="mi">12</span><span class="p">)</span>
